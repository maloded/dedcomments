// Comments SPA — Prisma schema
// Domain: anonymous authors leave tree-structured comments (Habr/Disqus style),
// optionally with one attachment. Moderators (JWT) can moderate.
// See CLAUDE.md → "Prisma schema (draft, reference)" and "Domain model".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// An anonymous comment author. NOT an account with a password — identified by
/// username + email captured at submission time. The same email can recur across
/// comments; we keep it as its own row so the root table can sort/aggregate by author.
model Author {
  id       String  @id @default(uuid())
  username String
  email    String
  homepage String?

  // Lowercased mirrors of username/email, kept in sync by AuthorsService.findOrCreate
  // (the only path that writes username/email — see code-style-reference.md →
  // "Case-insensitive sorting"). Sorted on instead of username/email so
  // `rootComments(sortBy: USERNAME | EMAIL)` is case-insensitive without Postgres's
  // default collation putting every "Z..." before every "a...". Prisma's `orderBy`
  // has no `mode: 'insensitive'` (that only exists on `where` filters), so this is
  // the idiomatic fallback.
  usernameLower String
  emailLower    String

  // Set by a moderator (banAuthor). A banned identity cannot post new comments.
  isBanned Boolean @default(false)

  comments Comment[]

  createdAt DateTime @default(now())

  // One row per (username, email) identity — the same person commenting again
  // reuses their Author row so the root table can aggregate/sort by author.
  @@unique([username, email])
  // Root-list sorting/pagination is by Author.username / Author.email (brief §3.2).
  @@index([username])
  @@index([email])
  // Case-insensitive root-list sorting (see usernameLower/emailLower above).
  @@index([usernameLower])
  @@index([emailLower])
  @@map("authors")
}

/// The core entity. Immutable after creation (no edits in the brief).
/// Root comment when parentId is null, otherwise a reply — a tree of unlimited depth.
model Comment {
  id       String @id @default(uuid())
  text     String
  authorId String
  author   Author @relation(fields: [authorId], references: [id])

  parentId String?
  parent   Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("Replies")

  attachment Attachment?

  // Moderation (JWT / Moderator role). Hidden comments stay in the tree structure
  // but are filtered out of public queries.
  isHidden Boolean @default(false)

  createdAt DateTime @default(now())

  // Default sort is LIFO by createdAt (brief §5); root list also sorts by date.
  @@index([createdAt])
  // Fetching a root's subtree and listing top-level comments both filter on parentId.
  @@index([parentId])
  @@index([parentId, createdAt])
  @@map("comments")
}

enum AttachmentType {
  IMAGE
  TEXT
}

/// Optional single attachment on a comment: a (resized) image or a text file.
model Attachment {
  id String @id @default(uuid())

  // Nullable: an attachment is uploaded on its own first, then linked when the
  // comment is created (createComment.attachmentId). Still @unique — at most one
  // attachment per comment.
  commentId String?  @unique
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  type         AttachmentType
  url          String
  originalName String
  size         Int
  // Set once the RabbitMQ worker has resized/validated the file.
  processedAt DateTime?

  createdAt DateTime @default(now())

  @@map("attachments")
}

/// A protected moderator account, authenticated via JWT. The only "real" login in
/// the system; used for hideComment / banAuthor mutations.
model Moderator {
  id           String @id @default(uuid())
  username     String @unique
  passwordHash String

  createdAt DateTime @default(now())

  @@map("moderators")
}

// NOTE: CAPTCHA challenges are stored in Redis (keyed by token, with a TTL), not
// in Postgres — see modules/captcha. There is deliberately no CaptchaChallenge model.
