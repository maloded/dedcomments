# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=4000
# Frontend origin allowed by CORS (Next.js dev server)
ALLOWED_ORIGIN=http://localhost:3000

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Used by docker-compose to provision the postgres container
POSTGRES_USER=comments
POSTGRES_PASSWORD=comments
POSTGRES_DB=comments
# Prisma connection string.
#   - running the app on the host (npm run start:dev):  host = localhost
#   - running the app in docker-compose:                host = postgres  (overridden in compose)
DATABASE_URL=postgresql://comments:comments@localhost:5432/comments?schema=public

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# Queue used for async attachment processing
RABBITMQ_ATTACHMENTS_QUEUE=attachments.process

# ─── Auth (Moderator role, JWT) ──────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# ─── CAPTCHA ─────────────────────────────────────────────────────────────────
# How long a generated CAPTCHA challenge stays valid, in seconds
CAPTCHA_TTL_SECONDS=300
